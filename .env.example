NODE_ENV=development
TZ=Europe/Istanbul

# Sunucu tarafı mutlak URL. Coolify production: https://alanadiniz.example
APP_URL=http://localhost:3000

# Yalnızca eski Vercel build'leri için uyumluluk değişkeni. Coolify'da gerekmez.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Coolify PostgreSQL kullanılıyorsa üçü de aynı internal/direct URL olabilir.
# Supabase kullanılıyorsa DATABASE_URL transaction pooler, DIRECT_URL doğrudan bağlantıdır.
DATABASE_URL=
DIRECT_URL=
PGBOSS_DATABASE_URL=
DB_POOL_MAX=5
PGBOSS_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Akran Değerlendirme <noreply@example.com>"
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=60000

# smtp: gerçek gönderim | log: konsol (yerel geliştirme)
EMAIL_MODE=log

# Coolify production: pgboss | yerel: inline | pasif Vercel geri dönüşü: qstash
JOB_BACKEND=inline
JOB_SCHEDULER_ENABLED=true
EMAIL_WORKER_CONCURRENCY=5
PGBOSS_SCHEMA=pgboss
JOB_LOG_RETENTION_DAYS=90
NOTIFICATION_LOG_RETENTION_DAYS=180

# Vercel/QStash pasif uyumluluk ayarları. JOB_BACKEND=qstash olmadıkça kullanılmaz.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Manuel cron endpoint'leri ve QStash fallback için güçlü rastgele değer.
CRON_SECRET=

# Rolling deployment/build version skew koruması için build-time değerler.
DEPLOYMENT_VERSION=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

INITIAL_TEACHER_EMAIL=
INITIAL_TEACHER_PASSWORD=
INITIAL_TEACHER_NAME=
